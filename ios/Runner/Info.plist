<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>TGG Mobile</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>TGG Mobile</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Answers TestFlight's export-compliance question at upload time
	     instead of leaving each build "Missing Compliance" until someone
	     answers it by hand in App Store Connect: the app only talks to its
	     own API over standard HTTPS/TLS, no custom encryption. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Declared even though the beacon toggle is hidden on iOS for now
	     (see AccountSettingsScreen): GeneratedPluginRegistrant registers
	     flutter_blue_plus_darwin and permission_handler_apple at launch
	     regardless, and if either touches CoreBluetooth/CoreLocation eagerly
	     rather than lazily, a missing usage string crashes the app on launch
	     on every device. UIBackgroundModes is deliberately NOT added here,
	     since that's only needed once the native beacon port lands.
	     NSLocationAlwaysAndWhenInUseUsageDescription is here for the same
	     reason: App Store Connect's binary scan flagged its absence
	     (ITMS-90683) since permission_handler_apple's compiled code
	     references the "Always" authorization API even though this app
	     doesn't call it yet -- Apple's check is static, not runtime. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>TGG Mobile uses Bluetooth to detect the club's check-in beacon when Auto Check-In is enabled.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>TGG Mobile uses your location to detect the club's check-in beacon when Auto Check-In is enabled.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>TGG Mobile uses your location to detect the club's check-in beacon when Auto Check-In is enabled.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
