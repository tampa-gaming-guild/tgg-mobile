default_platform(:ios)

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch('ASC_KEY_ID'),
    issuer_id: ENV.fetch('ASC_ISSUER_ID'),
    key_content: ENV.fetch('ASC_KEY_CONTENT'),
    is_key_content_base64: true,
  )
end

platform :ios do
  # No-op unless ENV['CI'] is set (GitHub Actions sets it automatically), so
  # this doesn't interfere with bootstrap_signing's "or locally" case below.
  # Without it, match's certificate import falls back to the runner's
  # login.keychain, which has no known password in a non-interactive
  # session -- security/Xcode then tries to pop a GUI unlock prompt that
  # nothing can ever click, and the job just hangs until it times out.
  # setup_ci creates a temporary keychain, unlocks it, makes it the
  # default, and disables that prompt.
  before_all do
    setup_ci
  end

  # Run manually via workflow_dispatch (or locally, MATCH_GIT_URL/MATCH_PASSWORD
  # set) once to generate the distribution cert + provisioning profile, and
  # again whenever the cert is renewed (yearly). Never run by the normal build
  # job -- that always uses readonly mode, see release_testflight below.
  desc 'Generate/refresh the App Store distribution cert and provisioning profile'
  lane :bootstrap_signing do
    asc_api_key
    match(type: 'appstore', readonly: false)
  end

  # The lane the ios.yml build job actually runs. readonly: true is
  # deliberate -- a normal CI run should never be able to mutate the shared
  # cert store, only bootstrap_signing (run intentionally, by a human) can.
  desc 'Build and upload a release to TestFlight (internal testers)'
  lane :release_testflight do
    api_key = asc_api_key
    match(type: 'appstore', readonly: true)

    # Scoped to the Runner target only, and applied to the .pbxproj rather
    # than forced globally via xcargs: this workspace's Flutter plugins are
    # Swift Package Manager dependencies (not CocoaPods), and SPM package
    # targets don't support manual provisioning profiles at all. Forcing
    # CODE_SIGN_STYLE=Manual on the whole build via xcargs applied it to
    # those package targets too and broke the archive ("does not support
    # provisioning profiles"). Runner is the only target that ships as an
    # app and needs one.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: 'Runner.xcodeproj',
      team_id: ENV.fetch('APPLE_TEAM_ID'),
      code_sign_identity: 'Apple Distribution',
      profile_name: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][ENV.fetch('IOS_BUNDLE_ID', 'com.tampagamingguild.tggmobile')],
      targets: ['Runner'],
    )

    build_app(
      workspace: 'Runner.xcworkspace',
      scheme: 'Runner',
      export_method: 'app-store',
      skip_build_archive: false,
      # Relative to this lane's working directory (ios/), so the .ipa lands
      # at <repo root>/build/ios/ipa -- matches the artifact path ios.yml
      # uploads, which runs with the default (repo root) working directory.
      output_directory: '../build/ios/ipa',
    )

    upload_to_testflight(
      api_key: api_key,
      groups: [ENV.fetch('TESTFLIGHT_GROUP', 'Internal')],
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end
end
